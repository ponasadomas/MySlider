{
  "name": "myslider",
  "version": "0.1.0",
  "private": true,
  "description": "Build-tool-agnostic React quiz/funnel slider. Successor to SliderFramework.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./layouts": {
      "import": "./dist/layouts.js",
      "types": "./dist/layouts.d.ts"
    },
    "./styles": "./dist/styles/slider.css",
    "./styles/source": "./src/styles/slider.scss"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "tsup && npm run build:styles",
    "build:js": "tsup",
    "build:styles": "sass --no-source-map src/styles/slider.scss dist/styles/slider.css",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "gsap": "^3.12.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "notyf": {
      "optional": true
    },
    "react-phone-number-input": {
      "optional": true
    },
    "use-sound": {
      "optional": true
    }
  },
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/react": "^18.2.65",
    "@types/react-dom": "^18.2.21",
    "gsap": "^3.15.0",
    "notyf": "^3.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-phone-number-input": "^3.4.16",
    "sass": "^1.79.4",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "use-sound": "^5.0.0"
  }
}
